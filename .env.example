# Backend local configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=8KB
SERVER_MAX_HTTP_FORM_POST_SIZE=1MB
MAX_REQUEST_BODY_SIZE=1048576

# Optional OpenAI-compatible provider settings. Keep the API key server-side.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_CONNECT_TIMEOUT=3s
AI_PROVIDER_RESPONSE_TIMEOUT=20s
